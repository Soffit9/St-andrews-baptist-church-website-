# Copy this to /etc/systemd/system/sabc-backend.service on the Pi
# (see README.md "Backend setup" section for the exact commands).

[Unit]
Description=St. Andrews Baptist Church backend (Flask)
After=network.target

[Service]
WorkingDirectory=/home/church/st-andrews-baptist-church-website-/backend
ExecStart=/home/church/st-andrews-baptist-church-website-/backend/venv/bin/gunicorn -w 2 -b 127.0.0.1:5000 app:app
Restart=always
User=church

[Install]
WantedBy=multi-user.target
